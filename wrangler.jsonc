// Deploys dist/ as a Worker with static assets, either by .github/workflows/deploy.yml on `v*` tags or by Cloudflare
// Workers Builds (see docs/DEPLOYMENT.md). VITE_API_BASE must be set at build time.
{
  "name": "temp-email-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (/console/..., /user/...) return index.html so client-side routes survive a reload.
    "not_found_handling": "single-page-application"
  }
}
