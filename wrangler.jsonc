// Deploys dist/ as a Worker with static assets. Released by .github/workflows/deploy.yml when a `v*` tag is pushed
// (see README → Deployment C). VITE_API_BASE must be set at build time.
{
  "name": "temp-email-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (/console/..., /user/...) return index.html so client-side routes survive a reload.
    "not_found_handling": "single-page-application"
  }
}
